# TMU CampusConnect - Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key (generate a strong random string for production)
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama settings (runs locally on the Windows machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ChromaDB settings
CHROMA_PERSIST_DIR=./data/chromadb

# SQLite Database
DATABASE_URL=sqlite:///./data/tmu_campusconnect.db

# University Name (shown in prompts and UI)
UNIVERSITY_NAME=Teerthanker Mahaveer University

# Optional: Web search (Brave Search API - free tier)
# Leave blank to disable web search
BRAVE_SEARCH_API_KEY=
